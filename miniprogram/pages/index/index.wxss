/* 主页样式 — 与播放页共用排版标准 v1（字号阶梯/间距/颜色见 episode.wxss 头注） */
.container { padding: 24rpx 28rpx 60rpx; }
.banner { width: 100%; height: 340rpx; border-radius: 20rpx; margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; line-height: 1.4; color: #222; margin-bottom: 8rpx; }
.desc { color: #666; font-size: 28rpx; line-height: 1.8; }
.section-title { font-size: 32rpx; font-weight: bold; line-height: 1.4; color: #222; margin: 44rpx 0 20rpx; }
.ep-card { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx; }
.ep-cover { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; }
.ep-info { flex: 1; margin-left: 20rpx; min-width: 0; }
.ep-title { font-size: 30rpx; font-weight: bold; line-height: 1.45; color: #222; margin-bottom: 8rpx; }
.ep-meta { color: #999; font-size: 24rpx; line-height: 1.6; }
.ep-arrow { color: #ccc; font-size: 40rpx; }
.how { background: #fff; border-radius: 20rpx; padding: 12rpx 28rpx; }
.how-item { display: flex; padding: 18rpx 0; font-size: 28rpx; line-height: 1.75; color: #333; border-bottom: 1rpx solid #f0f0f0; }
.how-item:last-child { border-bottom: none; }
.how-emoji { margin-right: 12rpx; }
.loading { text-align: center; color: #999; padding: 100rpx 0; font-size: 28rpx; }
/* 底部迷你播放器（紧凑半透明条；控件用 view 不用原生 button，原生 button 尺寸不可控会撑大） */
.np-bar { position: fixed; left: 16rpx; right: 16rpx; bottom: 20rpx; z-index: 99; display: flex; align-items: center; background: rgba(255,255,255,0.88); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: 20rpx; padding: 12rpx 18rpx; box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.14); }
.np-cover { width: 104rpx; height: 104rpx; border-radius: 14rpx; flex-shrink: 0; }
.np-info { flex: 1; margin-left: 16rpx; min-width: 0; overflow: hidden; }
.np-title { font-size: 27rpx; font-weight: bold; line-height: 1.45; color: #222; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.np-sub { color: #999; font-size: 24rpx; line-height: 1.45; margin-top: 2rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.np-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background: #ff8c42; color: #fff; font-size: 25rpx; display: flex; align-items: center; justify-content: center; margin-left: 12rpx; flex-shrink: 0; }
.np-stop { background: rgba(0,0,0,0.06); color: #666; font-size: 22rpx; }
.np-spacer { height: 140rpx; }

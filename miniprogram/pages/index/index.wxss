.container { padding: 24rpx 28rpx 60rpx; }
.banner { width: 100%; height: 340rpx; border-radius: 24rpx; margin-bottom: 24rpx; }
.title { font-size: 44rpx; font-weight: bold; margin-bottom: 12rpx; }
.desc { color: #888; font-size: 28rpx; line-height: 1.7; margin-bottom: 32rpx; }
.section-title { font-size: 34rpx; font-weight: bold; margin: 28rpx 0 16rpx; }
.ep-card { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.ep-cover { width: 140rpx; height: 140rpx; border-radius: 14rpx; flex-shrink: 0; }
.ep-info { flex: 1; margin-left: 20rpx; }
.ep-title { font-size: 32rpx; font-weight: bold; margin-bottom: 8rpx; }
.ep-meta { color: #999; font-size: 24rpx; margin-bottom: 8rpx; }
.tag { background: #fff2e6; color: #e07b2e; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; margin-right: 10rpx; }
.ep-arrow { color: #ccc; font-size: 44rpx; }
.how { background: #fff; border-radius: 20rpx; padding: 8rpx 20rpx; }
.how-item { display: flex; padding: 16rpx 0; font-size: 28rpx; border-bottom: 1rpx solid #f0f0f0; }
.how-item:last-child { border-bottom: none; }
.how-emoji { margin-right: 12rpx; }
.loading { text-align: center; color: #999; padding: 100rpx 0; font-size: 28rpx; }

<view class="container">
  <view wx:if="{{loading}}" class="loading">节目单加载中…</view>
  <block wx:else>
  <image class="banner" src="{{episodes[0].cover}}" mode="aspectFill"></image>
  <view class="title">🎧 Michael 的早听晚读</view>
  <view class="desc">每天一期双语播客：早上听故事磨耳朵，晚上读讲义练精读。献给每一个想学好英语的人。</view>

  <view class="section-title">📻 节目单</view>
  <block wx:for="{{episodes}}" wx:key="id">
    <view class="ep-card" bindtap="goEpisode" data-id="{{item.id}}">
      <image class="ep-cover" src="{{item.cover}}" mode="aspectFill"></image>
      <view class="ep-info">
        <view class="ep-title">{{item.id}} · {{item.title}}</view>
        <view class="ep-meta">英文 {{item.words}} 词 ｜ 音频 {{item.duration}}</view>
      </view>
      <view class="ep-arrow">›</view>
    </view>
  </block>

  <view class="section-title">📖 怎么学</view>
  <view class="how">
    <view class="how-item"><text class="how-emoji">🎧</text><text>早听：跟读页点开即播，英文高亮跟到哪读到哪</text></view>
    <view class="how-item"><text class="how-emoji">📄</text><text>晚读：下载讲义 PDF，做词汇、阅读、仿写练习</text></view>
  </view>
  </block>

  <!-- 底部迷你播放器：有节目在背景播放时出现 -->
  <view wx:if="{{nowPlaying}}" class="np-bar" bindtap="npGo">
    <image wx:if="{{nowPlaying.cover}}" class="np-cover" src="{{nowPlaying.cover}}" mode="aspectFill"></image>
    <view class="np-info">
      <view class="np-title">{{npPlaying ? '正在播放' : '已暂停'}} · {{nowPlaying.id}}</view>
      <view class="np-sub">{{nowPlaying.title}} · 点按回到这一期</view>
    </view>
    <view class="np-btn" catchtap="npToggle">{{npPlaying ? '⏸' : '▶'}}</view>
    <view class="np-btn np-stop" catchtap="npStop">⏹</view>
  </view>
  <view wx:if="{{nowPlaying}}" class="np-spacer"></view>
</view>

/* 购买页样式 — 排版标准 v1：T1 36/700、正文 30/1.8、卡片圆角 20、内边距 28、卡片间隔 20 */
.container { box-sizing: border-box; padding: 24rpx 28rpx 32rpx; }
.title { font-size: 36rpx; font-weight: bold; line-height: 1.4; color: #222; margin-bottom: 8rpx; }
.desc { color: #666; font-size: 30rpx; line-height: 1.8; margin-bottom: 40rpx; }
.price-card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }
.price { font-size: 54rpx; font-weight: bold; line-height: 1.4; color: #ff8c42; }
.price-sub { color: #666; font-size: 26rpx; line-height: 1.7; margin: 8rpx 0 20rpx; }
.benefit { color: #333; font-size: 30rpx; line-height: 1.8; }
.free-note { color: #999; font-size: 26rpx; line-height: 1.7; margin-top: 20rpx; }
.primary-btn { background: #ff8c42; color: #fff; font-size: 30rpx; font-weight: bold; text-align: center; line-height: 1.5; border-radius: 12rpx; padding: 20rpx 0; margin-top: 24rpx; }
.primary-btn.disabled { background: #ccc; }
.member-card { background: #f4f7ff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }
.member-line { font-size: 32rpx; font-weight: bold; line-height: 1.4; color: #1a56db; }
.member-exp { color: #333; font-size: 30rpx; line-height: 1.8; margin-top: 8rpx; }
.member-row { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #dbe4ff; }
.member-row-line { color: #333; font-size: 28rpx; line-height: 1.9; }
.member-note { color: #666; font-size: 26rpx; line-height: 1.7; margin-top: 8rpx; }
.taobao-card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }
.taobao-title { font-size: 30rpx; font-weight: bold; line-height: 1.4; color: #222; margin-bottom: 8rpx; }
.taobao-note { color: #666; font-size: 26rpx; line-height: 1.7; margin-bottom: 20rpx; }
.taobao-btn { background: #1a56db; color: #fff; font-size: 30rpx; font-weight: bold; line-height: 1.5; border-radius: 12rpx; padding: 20rpx 0; }
.taobao-btn::after { border: none; }
.bind-result { display: block; color: #333; font-size: 26rpx; line-height: 1.7; margin-top: 16rpx; }
.link-btn { color: #1a56db; font-size: 28rpx; line-height: 1.8; text-align: center; padding: 16rpx 0; }

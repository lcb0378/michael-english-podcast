<view class="container">
  <view wx:if="{{loading}}" class="loading">节目加载中…</view>
  <block wx:elif="{{ep}}">
  <video wx:if="{{ep.video}}" id="epVideo" class="cover-video" src="{{ep.video}}" poster="{{ep.cover}}" controls bindplay="onVideoPlay"></video>
  <image wx:else class="cover" src="{{ep.cover}}" mode="aspectFill"></image>
  <view class="head-row">
    <view class="head-left">
      <view class="title">{{ep.id}} · {{ep.title}}</view>
      <view class="meta">英文 {{ep.words}} 词 ｜ 音频 {{ep.duration}}</view>
    </view>
    <view class="head-btns">
      <view class="dl-btn" bindtap="downloadPdf">📄 下载 PDF 讲义</view>
      <view class="dl-btn ra-btn" bindtap="openReadalong">🌐 网页跟读版</view>
    </view>
  </view>

  <view class="player">
    <view class="controls">
      <button class="play-btn" bindtap="togglePlay">{{playing ? '⏸' : '▶'}}</button>
      <slider class="progress" min="0" max="1000" value="{{progress}}" bindchanging="onSeeking" bindchange="onSeek" block-size="14" activeColor="#ff8c42"></slider>
      <text class="time">{{curTime}} / {{durTime}}</text>
    </view>
    <view class="speeds">
      <block wx:for="{{rates}}" wx:key="*">
        <button class="speed-btn {{rate===item?'active':''}}" bindtap="setRate" data-r="{{item}}">{{item}}x</button>
      </block>
    </view>
  </view>

  <view class="part-head">📖 Part 1：双语精读对照</view>

  <block wx:for="{{ep.blocks}}" wx:for-index="bi" wx:key="bi">
    <view wx:if="{{item.sec}}" class="sec-head">Section {{item.sec}}</view>
    <view class="block {{curBlock===bi?'active':''}}" bindtap="tapBlock" data-idx="{{bi}}">
      <view class="en">
        <block wx:for="{{item.words}}" wx:for-index="wi" wx:key="wi">
          <text class="w {{curBlock===bi&&curWord===wi?'hl':''}}">{{item.w}} </text>
        </block>
      </view>
      <view class="cn">{{item.cn}}</view>
    </view>
  </block>

  <!-- 晚读讲义：直接在小程序里看和做题 -->
  <view wx:if="{{ep.guide}}" class="guide">
    <!-- Part 2 词汇 -->
    <view class="g-sec">
      <view class="g-h2">📚 Part 2：核心词汇</view>
      <block wx:for="{{ep.guide.vocab}}" wx:key="word">
        <view class="vocab">
          <view class="v-word">{{item.word}} <text class="v-phon">{{item.phon}}</text></view>
          <view class="v-meaning">{{item.meaning}}</view>
          <view class="v-example">{{item.example}}</view>
        </view>
      </block>
    </view>

    <!-- Part 3 练习题（互动版：有答案键时点选答题；无键回退静态） -->
    <view class="g-sec">
      <view class="g-h2">✏️ Part 3：阅读理解自测</view>
      <block wx:if="{{quizVm}}">
        <!-- 填字游戏（有 crossword 数据时替代标题配对） -->
        <block wx:if="{{ep.guide.crossword}}">
        <view class="g-h3">A. 填字游戏 Crossword</view>
        <text class="q-note">点一条提示选中空位，再在词库里点一个词填进去（长度要对得上）。填错了再点那条词可以清空重选，最后点「核对答案」。</text>
        <view class="cw-grid">
          <view wx:for="{{cwGrid}}" wx:for-item="row" wx:for-index="r" wx:key="r" class="cw-row">
            <view wx:for="{{row}}" wx:for-item="cell" wx:for-index="c" wx:key="c" class="cw-cell {{cell.blank ? 'blk' : ''}} {{cell.sel ? 'sel' : ''}} {{cell.st==='ok' ? 'ok' : ''}} {{cell.st==='bad' ? 'bad' : ''}}" data-r="{{r}}" data-c="{{c}}" bindtap="cwTapCell">
              <text wx:if="{{cell.num}}" class="cw-num">{{cell.num}}</text>
              <text class="cw-letter">{{cell.letter}}</text>
            </view>
          </view>
        </view>
        <view class="cw-bank">
          <view wx:for="{{cwVm.bank}}" wx:key="*this" class="cw-chip {{cwUsed[item] ? 'used' : ''}}" data-wi="{{item}}" bindtap="cwTapChip">{{ep.guide.crossword.words[item].word}} <text class="cw-cn">{{ep.guide.crossword.words[item].cn}}</text></view>
        </view>
        <view class="g-h3">提示 Clues（按编号顺序）</view>
        <view wx:for="{{cwVm.list}}" wx:key="i" class="cw-clue {{cwSel===item.i ? 'sel' : ''}}" data-i="{{item.i}}" bindtap="cwTapClue">
          <text><text class="cw-lab">{{item.w.num}} {{item.w.dir==='A' ? '横' : '竖'}}.</text> {{item.w.clue}}</text>
          <text wx:if="{{cwMark[item.i]===true}}" class="mark-ok">✓</text>
          <text wx:if="{{cwMark[item.i]===false}}" class="mark-no">✗</text>
        </view>
        <view class="check-row">
          <view class="check-btn" bindtap="cwCheck">✔ 核对答案</view>
          <view class="reset-btn" bindtap="cwReset">重做</view>
        </view>
        <text wx:if="{{cwScore}}" class="score">{{cwScore}}</text>
        </block>
        <view wx:if="{{quizVm.choiceTitle}}" class="g-h3">{{quizVm.choiceTitle}}</view>
        <block wx:for="{{quizVm.choiceQs}}" wx:for-index="qi" wx:key="qi">
          <text class="q">{{qi+1}}. {{item.stem}}</text>
          <view wx:for="{{item.options}}" wx:for-item="op" wx:for-index="oi" wx:key="*this" class="opt {{selC[qi]===oi ? 'sel ' : ''}}{{markC[qi]!==null && oi===keyC[qi] ? 'right' : ''}} {{markC[qi]===false && selC[qi]===oi ? 'wrong' : ''}}" data-q="{{qi}}" data-o="{{oi}}" bindtap="pickC">{{op}}</view>
          <text wx:if="{{markC[qi]===false}}" class="ans-line">正确答案：{{keyCL[qi]}}</text>
        </block>
        <view wx:if="{{quizVm.choiceQs.length}}" class="check-row">
          <view class="check-btn" bindtap="check3">✔ 核对答案</view>
          <view class="reset-btn" bindtap="reset3">重做</view>
        </view>
        <text wx:if="{{score3}}" class="score">{{score3}}</text>
      </block>
      <block wx:else>
        <block wx:for="{{ep.guide.quiz}}" wx:for-index="si" wx:key="title">
          <view class="g-h3">{{item.title}}</view>
          <block wx:for="{{item.questions}}" wx:for-index="qi" wx:key="qi">
            <text class="q">{{qi+1}}. {{item}}</text>
          </block>
          <text wx:if="{{item.extra}}" class="q-extra">{{item.extra}}</text>
        </block>
      </block>
    </view>

    <!-- Part 4 长难句 -->
    <view wx:if="{{ep.guide.sentence_nodes}}" class="g-sec">
      <view class="g-h2">🔬 Part 4：长难句深度拆解与练习</view>
      <rich-text class="rt" tag-style="{{tagStyle}}" nodes="{{ep.guide.sentence_nodes}}"></rich-text>
      <!-- 互动练习（Part 4 句型练习点选版，有 practice 数据时显示） -->
      <block wx:if="{{ep.guide.practice}}">
        <view class="g-h3">✍️ 句型练习 · 互动版（点选答案）</view>
        <block wx:for="{{ep.guide.practice.groups}}" wx:for-index="gi" wx:key="name">
          <view class="g-h3">{{item.name}}</view>
          <block wx:for="{{item.items}}" wx:for-index="ii" wx:key="ii">
            <text class="q">{{item.prompt}}</text>
            <block wx:if="{{item.options}}">
              <view wx:for="{{item.options}}" wx:for-item="op" wx:for-index="oi" wx:key="*this" class="opt {{selP[gi][ii]===oi ? 'sel ' : ''}}{{markP[gi][ii]!==null && oi===item.answer ? 'right' : ''}} {{markP[gi][ii]===false && selP[gi][ii]===oi ? 'wrong' : ''}}" data-g="{{gi}}" data-i="{{ii}}" data-o="{{oi}}" bindtap="pickP">{{op}}</view>
              <text wx:if="{{markP[gi][ii]===false}}" class="ans-line">正确答案：{{item.options[item.answer]}}</text>
            </block>
          </block>
        </block>
        <view class="check-row">
          <view class="check-btn" bindtap="check4">✔ 核对答案</view>
          <view class="reset-btn" bindtap="reset4">重做</view>
        </view>
        <text wx:if="{{score4}}" class="score">{{score4}}</text>
        <block wx:if="{{ep.guide.practice.open}}">
          <view class="g-h3">{{ep.guide.practice.open_title}}</view>
          <text wx:for="{{ep.guide.practice.open}}" wx:key="*this" class="q">{{index+1}}. {{item}}</text>
          <text class="q-note">开放练习，没有标准答案，自己动手写一写。</text>
        </block>
      </block>
    </view>

    <!-- Part 5 答案 -->
    <view wx:if="{{ep.guide.answers_nodes}}" class="g-sec">
      <view class="g-h2">✅ Part 5：答案与解析</view>
      <!-- 填字答案格（正解填满的静态格，与网页版/PDF 同一副数据）；其后的富文本是逐词答案表 -->
      <block wx:if="{{ep.guide.crossword}}">
        <view class="g-h3">A. Crossword 填字答案</view>
        <view class="cw-grid">
          <view wx:for="{{cwAnsGrid}}" wx:for-item="row" wx:for-index="r" wx:key="r" class="cw-row">
            <view wx:for="{{row}}" wx:for-item="cell" wx:for-index="c" wx:key="c" class="cw-cell {{cell.blank ? 'blk' : ''}}">
              <text wx:if="{{cell.num}}" class="cw-num">{{cell.num}}</text>
              <text class="cw-letter">{{cell.letter}}</text>
            </view>
          </view>
        </view>
      </block>
      <rich-text class="rt" tag-style="{{tagStyle}}" nodes="{{ep.guide.answers_nodes}}"></rich-text>
    </view>
  </view>

  <view class="pdf-dl">
    <view class="pdf-btn" bindtap="downloadPdf">📄 下载本期晚读讲义 PDF</view>
    <view class="pdf-btn ra-btn2" bindtap="openReadalong">🌐 网页跟读版（边听边看高亮）</view>
    <view class="pdf-tip">想打印出来做？点第一个下载 PDF；想边听边跟读，点第二个复制链接、去浏览器打开</view>
  </view>
  </block>
</view>

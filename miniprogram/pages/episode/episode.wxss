/* ===== 排版标准 v1（2026-10-20 定版，全期共用） =====
   字号阶梯：T1 主标题 36/700｜T2 区块标题 32/700｜T3 小节标题 30/700
   正文：跟读英文 34/行高1.9｜通用正文 30/行高1.8｜辅助 26/行高1.7｜注释 24/行高1.6（2026-10-22 真机反馈上调一号；加粗一律同字号 700）
   间距：卡片内边距 28｜卡片间隔 20｜区块间隔 40｜段落间隔 16｜标题下 16
   颜色：标题 #222｜正文 #333｜次级 #666｜注释 #999｜橙 #ff8c42｜蓝 #1a56db
   圆角：卡片 20｜小框 12 ==================================== */
.container { padding: 24rpx 28rpx 60rpx; }
.cover { width: 100%; height: 360rpx; border-radius: 20rpx; margin-bottom: 24rpx; }
.cover-video { width: 100%; height: 360rpx; border-radius: 20rpx; margin-bottom: 24rpx; background: #000; }
.head-row { display: flex; align-items: flex-start; margin-bottom: 24rpx; }
.head-left { flex: 1; min-width: 0; }
.title { font-size: 36rpx; font-weight: bold; line-height: 1.4; color: #222; margin-bottom: 8rpx; }
.meta { color: #999; font-size: 24rpx; line-height: 1.6; }
.dl-btn { flex-shrink: 0; background: #1a56db; color: #fff; font-size: 24rpx; line-height: 1.5; border-radius: 999rpx; padding: 9rpx 20rpx; margin: 6rpx 0 0 16rpx; white-space: nowrap; text-align: center; }
.player { position: sticky; top: 0; background: #fff; border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx; z-index: 10; }
.controls { display: flex; align-items: center; }
.play-btn { flex: 0 0 96rpx; width: 96rpx; height: 96rpx; min-width: 96rpx; border-radius: 50%; background: #ff8c42; color: #fff; font-size: 36rpx; line-height: 96rpx; padding: 0; margin: 0 16rpx 0 0; }
.play-btn::after { border: none; }
.progress { flex: 1 1 auto; margin: 0 12rpx; min-width: 0; }
.time { flex: 0 0 auto; font-size: 24rpx; line-height: 1.6; color: #999; white-space: nowrap; }
.speeds { display: flex; margin-top: 16rpx; }
.speed-btn { font-size: 26rpx; padding: 0 28rpx; line-height: 56rpx; border-radius: 28rpx; margin-right: 16rpx; background: #f5f5f5; color: #666; }
.speed-btn.active { background: #ff8c42; color: #fff; }
/* 跟读块 */
.part-head { font-size: 32rpx; font-weight: bold; line-height: 1.4; color: #1a56db; border-bottom: 2rpx solid #1a56db; padding-bottom: 12rpx; margin: 4rpx 0 20rpx; }
.block { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; border: 4rpx solid transparent; }
.block.active { border-color: #ff8c42; background: #fff8f2; }
.sec-head { font-size: 30rpx; line-height: 1.6; color: #1a56db; font-weight: 700; margin: 40rpx 0 16rpx; padding-bottom: 10rpx; border-bottom: 2rpx solid #dbeafe; }
.q-note { display: block; font-size: 26rpx; line-height: 1.7; color: #666; margin-bottom: 16rpx; }
.en { font-size: 34rpx; line-height: 1.9; color: #222; margin-bottom: 12rpx; }
.w.hl { background: #ffe082; border-radius: 6rpx; }
.cn { color: #666; font-size: 30rpx; line-height: 1.8; }
/* 下载区 */
.pdf-dl { text-align: center; background: #fff; border-radius: 20rpx; padding: 36rpx 28rpx; margin-top: 24rpx; }
.pdf-btn { background: #ff8c42; color: #fff; font-size: 28rpx; border-radius: 40rpx; padding: 10rpx 0; }
.pdf-tip { color: #999; font-size: 24rpx; line-height: 1.6; margin-top: 16rpx; }
.loading { text-align: center; color: #999; padding: 100rpx 0; font-size: 28rpx; }
/* 晚读讲义 */
.guide { background: #fff; border-radius: 20rpx; padding: 36rpx 28rpx; margin-top: 24rpx; }
.g-sec { margin-bottom: 40rpx; }
.g-sec:last-child { margin-bottom: 0; }
.g-h2 { font-size: 32rpx; font-weight: bold; line-height: 1.4; color: #1a56db; border-bottom: 2rpx solid #1a56db; padding-bottom: 12rpx; margin-bottom: 20rpx; }
.g-h3 { font-size: 30rpx; font-weight: bold; line-height: 1.45; color: #222; margin: 24rpx 0 12rpx; }
.g-h3:first-of-type { margin-top: 0; }
.vocab { background: #fffbe8; border: 1rpx solid #ecd27a; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.vocab:last-child { margin-bottom: 0; }
.v-word { font-size: 32rpx; font-weight: bold; line-height: 1.4; color: #222; margin-bottom: 8rpx; }
.v-phon { color: #999; font-size: 26rpx; font-weight: normal; }
.v-meaning { font-size: 30rpx; line-height: 1.8; color: #333; margin-bottom: 8rpx; }
.v-example { font-size: 26rpx; line-height: 1.7; color: #666; font-style: italic; }
.q { display: block; font-size: 30rpx; line-height: 1.8; color: #333; margin-bottom: 16rpx; }
.q:last-child { margin-bottom: 0; }
.q-extra { display: block; font-size: 26rpx; line-height: 1.75; color: #666; background: #f5f5f5; border-radius: 12rpx; padding: 20rpx; margin-top: 16rpx; }
/* 讲义富文本（Part 4/5）：正文同级 28/1.8，段距由 tag-style 补齐 */
.rt { font-size: 30rpx; line-height: 1.8; color: #333; }

/* 互动答题（2026-10-21）：点选/判分样式，数值按排版标准 v1 */
.hq-row { display: flex; align-items: center; gap: 10rpx; margin: 12rpx 0; flex-wrap: nowrap; }
.hq-label { font-size: 26rpx; color: #333; width: 132rpx; flex: none; }
.chips { display: flex; flex-wrap: nowrap; gap: 8rpx; flex: none; }
.chip { width: 54rpx; height: 54rpx; line-height: 54rpx; text-align: center; border: 2rpx solid #cbd5e1; border-radius: 50%; font-size: 25rpx; color: #333; background: #fff; flex: none; }
.chip.sel { border-color: #ff8c42; background: #fff3e8; color: #e56f1f; font-weight: 700; }
.chip.right { border-color: #22a06b; background: #e7f8f0; color: #178a5a; font-weight: 700; }
.chip.wrong { border-color: #e5484d; background: #fdecec; color: #c62f35; font-weight: 700; }
.hq-ref { background: #f5f5f5; border-radius: 12rpx; padding: 20rpx; margin: 16rpx 0 8rpx; }
.q-line { display: block; font-size: 26rpx; line-height: 1.75; color: #666; }
.opt { font-size: 30rpx; line-height: 1.6; color: #333; border: 2rpx solid #e2e8f0; border-radius: 12rpx; padding: 14rpx 18rpx; margin: 10rpx 0; background: #fff; }
.opt.sel { border-color: #ff8c42; background: #fff3e8; }
.opt.right { border-color: #22a06b; background: #e7f8f0; }
.opt.wrong { border-color: #e5484d; background: #fdecec; }
.check-row { display: flex; gap: 16rpx; margin: 24rpx 0 8rpx; }
.check-btn { background: #1a56db; color: #fff; font-size: 28rpx; padding: 16rpx 30rpx; border-radius: 999rpx; }
.reset-btn { background: #eef2f7; color: #475569; font-size: 28rpx; padding: 16rpx 30rpx; border-radius: 999rpx; }
.score { display: block; font-size: 28rpx; line-height: 1.7; color: #1a56db; font-weight: 700; margin: 12rpx 0; }
.mark-ok { color: #178a5a; font-size: 32rpx; font-weight: 700; flex: none; }
.mark-no { color: #c62f35; font-size: 26rpx; flex: none; }
.ans-line { display: block; color: #c62f35; font-size: 26rpx; line-height: 1.6; margin: 6rpx 0 12rpx; }

/* ===== 填字游戏（2026-10-21 新增） ===== */
.cw-grid { margin: 12rpx 0 6rpx; }
.cw-row { display: flex; gap: 3rpx; margin-bottom: 3rpx; }
.cw-cell { flex: 1; height: 52rpx; border: 2rpx solid #33475b; border-radius: 6rpx; position: relative; display: flex; align-items: center; justify-content: center; background: #fff; box-sizing: border-box; }
.cw-cell.blk { background: #33475b; border-color: #33475b; }
.cw-cell.sel { background: #ffe58a; }
.cw-cell.ok { background: #d8f3dc; }
.cw-cell.bad { background: #fdecec; }
.cw-num { position: absolute; top: 0; left: 4rpx; font-size: 15rpx; line-height: 1.2; color: #666; }
.cw-letter { font-size: 29rpx; font-weight: 700; color: #222; }
.cw-bank { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 14rpx 0 6rpx; }
.cw-chip { border: 2rpx solid #33475b; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: 26rpx; font-weight: 700; color: #222; background: #fff; }
.cw-chip.used { opacity: 0.25; }
.cw-cn { font-size: 23rpx; font-weight: 400; color: #666; }
.cw-clue { font-size: 27rpx; line-height: 1.6; color: #333; padding: 10rpx 14rpx; border-radius: 12rpx; margin: 6rpx 0; background: #fff; border: 2rpx solid #e2e8f0; }
.cw-clue.sel { border-color: #ff8c42; background: #fff7ed; }
.cw-dir { font-size: 21rpx; color: #999; }
.cw-lab { font-weight: 700; color: #222; }

/* 顶部两钮（下载 PDF 讲义/网页跟读版）等宽等高：纵排 stretch 拉齐到较宽者宽度（2026-10-22 David 定版） */
.head-btns { display: flex; flex-direction: column; gap: 10rpx; align-items: stretch; }
.ra-btn { background: #0ca678; }
.ra-btn2 { background: #0ca678; margin-top: 16rpx; }

/* ===== 排版标准 v1（2026-10-20 定版，全期共用） =====
   字号阶梯：T1 主标题 36/700｜T2 区块标题 32/700｜T3 小节标题 30/700
   正文：跟读英文 32/行高1.9｜通用正文 28/行高1.8｜辅助 26/行高1.7｜注释 24/行高1.6
   间距：卡片内边距 28｜卡片间隔 20｜区块间隔 40｜段落间隔 16｜标题下 16
   颜色：标题 #222｜正文 #333｜次级 #666｜注释 #999｜橙 #ff8c42｜蓝 #1a56db
   圆角：卡片 20｜小框 12 ==================================== */
.container { padding: 24rpx 28rpx 60rpx; }
.cover { width: 100%; height: 360rpx; border-radius: 20rpx; margin-bottom: 24rpx; }
.head-row { display: flex; align-items: flex-start; margin-bottom: 24rpx; }
.head-left { flex: 1; min-width: 0; }
.title { font-size: 36rpx; font-weight: bold; line-height: 1.4; color: #222; margin-bottom: 8rpx; }
.meta { color: #999; font-size: 24rpx; line-height: 1.6; }
.dl-btn { flex-shrink: 0; background: #1a56db; color: #fff; font-size: 28rpx; border-radius: 36rpx; padding: 0 30rpx; line-height: 72rpx; margin: 4rpx 0 0 16rpx; }
.dl-btn::after { border: none; }
.player { position: sticky; top: 0; background: #fff; border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx; z-index: 10; }
.controls { display: flex; align-items: center; }
.play-btn { flex: 0 0 96rpx; width: 96rpx; height: 96rpx; min-width: 96rpx; border-radius: 50%; background: #ff8c42; color: #fff; font-size: 36rpx; line-height: 96rpx; padding: 0; margin: 0 16rpx 0 0; }
.play-btn::after { border: none; }
.progress { flex: 1 1 auto; margin: 0 12rpx; min-width: 0; }
.time { flex: 0 0 auto; font-size: 24rpx; line-height: 1.6; color: #999; white-space: nowrap; }
.speeds { display: flex; margin-top: 16rpx; }
.speed-btn { font-size: 26rpx; padding: 0 28rpx; line-height: 56rpx; border-radius: 28rpx; margin-right: 16rpx; background: #f5f5f5; color: #666; }
.speed-btn.active { background: #ff8c42; color: #fff; }
/* 跟读块 */
.block { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; border: 4rpx solid transparent; }
.block.active { border-color: #ff8c42; background: #fff8f2; }
.sec-title { font-size: 26rpx; line-height: 1.5; color: #ff8c42; font-weight: bold; margin-bottom: 12rpx; }
.en { font-size: 32rpx; line-height: 1.9; color: #222; margin-bottom: 12rpx; }
.w.hl { background: #ffe082; border-radius: 6rpx; }
.cn { color: #666; font-size: 28rpx; line-height: 1.8; }
/* 下载区 */
.pdf-dl { text-align: center; background: #fff; border-radius: 20rpx; padding: 36rpx 28rpx; margin-top: 24rpx; }
.pdf-btn { background: #ff8c42; color: #fff; font-size: 28rpx; border-radius: 40rpx; padding: 10rpx 0; }
.pdf-tip { color: #999; font-size: 24rpx; line-height: 1.6; margin-top: 16rpx; }
.loading { text-align: center; color: #999; padding: 100rpx 0; font-size: 28rpx; }
/* 晚读讲义 */
.guide { background: #fff; border-radius: 20rpx; padding: 36rpx 28rpx; margin-top: 24rpx; }
.guide-title { font-size: 36rpx; font-weight: bold; line-height: 1.4; color: #222; text-align: center; margin-bottom: 28rpx; }
.g-sec { margin-bottom: 40rpx; }
.g-sec:last-child { margin-bottom: 0; }
.g-h2 { font-size: 32rpx; font-weight: bold; line-height: 1.4; color: #1a56db; border-bottom: 2rpx solid #1a56db; padding-bottom: 12rpx; margin-bottom: 20rpx; }
.g-h3 { font-size: 30rpx; font-weight: bold; line-height: 1.45; color: #222; margin: 24rpx 0 12rpx; }
.g-h3:first-of-type { margin-top: 0; }
.vocab { background: #fffbe8; border: 1rpx solid #ecd27a; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.vocab:last-child { margin-bottom: 0; }
.v-word { font-size: 32rpx; font-weight: bold; line-height: 1.4; color: #222; margin-bottom: 8rpx; }
.v-phon { color: #999; font-size: 26rpx; font-weight: normal; }
.v-meaning { font-size: 28rpx; line-height: 1.8; color: #333; margin-bottom: 8rpx; }
.v-example { font-size: 26rpx; line-height: 1.7; color: #666; font-style: italic; }
.q { font-size: 28rpx; line-height: 1.8; color: #333; margin-bottom: 16rpx; }
.q:last-child { margin-bottom: 0; }
.q-extra { font-size: 26rpx; line-height: 1.7; color: #666; background: #f5f5f5; border-radius: 12rpx; padding: 20rpx; margin-top: 16rpx; }
/* 讲义富文本（Part 4/5）：正文同级 28/1.8，段距由 tag-style 补齐 */
.rt { font-size: 28rpx; line-height: 1.8; color: #333; }

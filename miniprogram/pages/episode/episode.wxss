.container { padding: 24rpx 28rpx 60rpx; }
.cover { width: 100%; height: 360rpx; border-radius: 24rpx; margin-bottom: 20rpx; }
.title { font-size: 40rpx; font-weight: bold; margin-bottom: 8rpx; }
.meta { color: #999; font-size: 26rpx; margin-bottom: 24rpx; }
.player { position: sticky; top: 0; background: #fff; border-radius: 20rpx; padding: 20rpx; margin-bottom: 20rpx; z-index: 10; }
.controls { display: flex; align-items: center; }
.play-btn { width: 96rpx; height: 96rpx; border-radius: 50%; background: #ff8c42; color: #fff; font-size: 36rpx; line-height: 96rpx; padding: 0; margin: 0 16rpx 0 0; flex-shrink: 0; }
.progress { flex: 1; margin: 0 12rpx; }
.time { font-size: 24rpx; color: #999; white-space: nowrap; }
.speeds { display: flex; margin-top: 16rpx; }
.speed-btn { font-size: 26rpx; padding: 0 28rpx; line-height: 56rpx; border-radius: 28rpx; margin-right: 16rpx; background: #f5f5f5; color: #666; }
.speed-btn.active { background: #ff8c42; color: #fff; }
.block { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; border: 4rpx solid transparent; }
.block.active { border-color: #ff8c42; background: #fff8f2; }
.sec-title { font-size: 24rpx; color: #ff8c42; font-weight: bold; margin-bottom: 12rpx; }
.en { font-size: 32rpx; line-height: 1.8; margin-bottom: 12rpx; }
.w.hl { background: #ffe082; border-radius: 6rpx; }
.cn { color: #999; font-size: 28rpx; line-height: 1.7; }
.pdf-dl { text-align: center; background: #fff; border-radius: 20rpx; padding: 40rpx 24rpx; margin-top: 24rpx; }
.pdf-btn { background: #ff8c42; color: #fff; font-size: 32rpx; border-radius: 44rpx; padding: 8rpx 0; }
.pdf-tip { color: #bbb; font-size: 24rpx; margin-top: 16rpx; }
